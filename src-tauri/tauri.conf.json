{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RudariFlow",
  "version": "0.11.0",
  "identifier": "com.rudariflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RudariFlow",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "label": "main",
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "oggi",
    "homepage": "https://0ggi.ch",
    "shortDescription": "Sprache-zu-Text Diktier-App, lokal angetrieben von Whisper.cpp",
    "longDescription": "RudariFlow ist eine lokale Diktier-App für Windows mit GPU-Beschleunigung (NVIDIA CUDA, AMD/Intel Vulkan). Drücke einen globalen Hotkey, sprich, und der transkribierte Text wird automatisch eingefügt. Unterstützt mehrere Sprachen via Whisper.cpp.",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "binaries/gpu-runtime/cudart64_13.dll": "cudart64_13.dll",
      "binaries/gpu-runtime/cublas64_13.dll": "cublas64_13.dll",
      "binaries/gpu-runtime/cublasLt64_13.dll": "cublasLt64_13.dll",
      "binaries/gpu-runtime/vulkan-1.dll": "vulkan-1.dll",
      "binaries/llama/*": "llama/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
